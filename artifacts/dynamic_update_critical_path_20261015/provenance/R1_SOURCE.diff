+def operator_group(group,op,sample,b):
+    kinds=[0,1,2] if op==2 else [1 if op==0 else 0]
+    assert [int(r['kind']) for r in group]==kinds
+    for r in group:
+        kind=int(r['kind']);assert int(r['sample'])==sample and int(r['rows'])==b
